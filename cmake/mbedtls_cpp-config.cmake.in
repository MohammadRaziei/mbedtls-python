@PACKAGE_INIT@

# Static Mbed TLS + the mbedtls_cpp core, as installed by this project. Hand written on purpose: the upstream targets
# keep build-tree paths in their properties and cannot be exported as they are.
include(CMakeFindDependencyMacro)

set(_mbedtls_cpp_libdir "${PACKAGE_PREFIX_DIR}/@_mbp_lib@")
# Order matters for static linking: each library needs the ones after it.
set(_mbedtls_cpp_libs "")
foreach(_name mbedtls_cpp_core mbedtls mbedx509 tfpsacrypto)
    find_library(_mbedtls_cpp_${_name} NAMES ${_name} PATHS "${_mbedtls_cpp_libdir}" NO_DEFAULT_PATH REQUIRED)
    list(APPEND _mbedtls_cpp_libs "${_mbedtls_cpp_${_name}}")
endforeach()

if(WIN32)
    list(APPEND _mbedtls_cpp_libs ws2_32 bcrypt)
else()
    find_dependency(Threads)
    list(APPEND _mbedtls_cpp_libs Threads::Threads)
endif()

# The same user config the libraries were built with: the layout of Mbed TLS structs (the threading mutex above
# all) depends on it, so a consumer compiled without it would disagree with the library.
set(_mbedtls_cpp_defs "TF_PSA_CRYPTO_USER_CONFIG_FILE=\"${PACKAGE_PREFIX_DIR}/@_mbp_inc@/mbedtls_cpp/mbedtls_config.h\"")
if(@MBEDTLS_CPP_THREADING_ALT@)
    list(APPEND _mbedtls_cpp_defs MBEDTLS_CPP_THREADING_ALT)
endif()

if(NOT TARGET mbedtls::cpp)
    add_library(mbedtls::cpp INTERFACE IMPORTED)
    set_target_properties(mbedtls::cpp PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/@_mbp_inc@"
        INTERFACE_COMPILE_DEFINITIONS "${_mbedtls_cpp_defs}"
        INTERFACE_LINK_LIBRARIES "${_mbedtls_cpp_libs}")
endif()

unset(_mbedtls_cpp_libdir)
unset(_mbedtls_cpp_libs)
unset(_mbedtls_cpp_defs)
